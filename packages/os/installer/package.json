{
  "name": "@elizaos/os-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Guided installer for elizaOS VM/bare-metal installation",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "predev": "node ../../shared/scripts/sync-to-public.mjs ./public --logos --favicons --ogembeds || true",
    "dev": "vite",
    "dev:server": "bun run src/server.ts",
    "dev:all": "concurrently \"bun run dev\" \"bun run dev:server\"",
    "prebuild": "node ../../shared/scripts/sync-to-public.mjs ./public --logos --favicons --ogembeds || true",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:server": "bun build src/server.ts --outdir dist --target node",
    "build:all": "bun run build && bun run build:server",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "test": "vitest run --config ./vitest.config.ts",
    "test:e2e": "playwright test",
    "lint": "bunx @biomejs/biome check src tests vite.config.ts",
    "server": "bun run src/server.ts",
    "start": "bun run dev:all",
    "build:app": "bunx electrobun build",
    "package:linux": "bunx electrobun build --platform linux"
  },
  "dependencies": {
    "vite": "^8.0.0",
    "@elizaos/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.0.0",
    "@types/react": "^18.0.0 || ^19.0.0",
    "@types/react-dom": "^18.0.0 || ^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0"
  }
}
